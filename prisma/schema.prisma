generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String              @id @default(uuid())
  name                    String
  email                   String              @unique
  password                String?
  avatar                  String?
  provider                String              @default("local")
  googleId                String?
  role                    Role                @default(user)
  status                  Status              @default(active)
  isVerified              Boolean             @default(false)
  otp                     String?
  otpExpires              DateTime?
  pushToken               String?
  points                  Int                 @default(50)
  lastLoginRewardClaimedAt DateTime?
  lastTxRewardClaimedAt    DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  transactions            Transaction[]
  dues                    Due[]
  goals                   Goal[]
  investments             InvestmentProject[]
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String?
  title     String
  amount    Float
  type      String   
  category  String  
  date      String  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Due {
  id         String   @id @default(uuid())
  userId     String?
  personName String
  phone      String?
  amount     Float
  type       String   // 'receivable' | 'payable'
  note       String?
  dueDate    String?
  isSettled  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id            String   @id @default(uuid())
  userId        String
  name          String
  targetAmount  Float
  description   String?
  isCompleted   Boolean  @default(false)
  pointsAwarded Int
  createdAt     String
  history       Json     @default("[]")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InvestmentProject {
  id           String   @id @default(uuid())
  userId       String
  name         String
  targetBudget Float?
  description  String?
  createdAt    String
  logs         Json     @default("[]")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Status {
  active
  inactive
  blocked
}

enum Role {
  user
  admin
}
